    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@welldone-software/why-did-you-render": "^10.0.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.1",
